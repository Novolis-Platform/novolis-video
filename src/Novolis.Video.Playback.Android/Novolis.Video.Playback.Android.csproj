<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>Novolis.Video.Playback.Android</RootNamespace>
    <AssemblyName>Novolis.Video.Playback.Android</AssemblyName>
    <PackageId>Novolis.Video.Playback.Android</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Composable Android video playback with progressive byte-source support.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Video.Abstractions" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
