<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Novolis.Video.Packaging.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Novolis.Video.Rtc</RootNamespace>
    <AssemblyName>Novolis.Video.Rtc</AssemblyName>
    <PackageId>Novolis.Video.Rtc</PackageId>
    <IsPackable>true</IsPackable>
    <Description>SIPSorcery-backed mesh RTC session implementing IRtcMeshSession.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\Novolis.Video.Rtc.Abstractions\Novolis.Video.Rtc.Abstractions.csproj" />
    <ProjectReference Include="..\Novolis.Video.Capture.Windows\Novolis.Video.Capture.Windows.csproj" />
    <PackageReference Include="SIPSorcery" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" />
    <PackageReference Include="SIPSorceryMedia.Windows" />
    <PackageReference Include="SIPSorceryMedia.Encoders" />
  </ItemGroup>
</Project>
